# Runtime data that must not go into the repository
storage/logs/*
storage/backups/*
storage/exports/*
!storage/logs/.gitkeep
!storage/backups/.gitkeep
!storage/exports/.gitkeep

# Dependencies of the Playwright browser tests
tests/browser/node_modules/
tests/browser/package-lock.json

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.log

# Local archives
*.zip

# Real database dumps must never be published (schema/seed/upgrade scripts are OK)
database/backup/*
!database/backup/.gitkeep
